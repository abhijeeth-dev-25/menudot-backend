# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB deployment
MONGODB_URI=mongodb://localhost:27017/menudot
MONGODB_USE_TRANSACTIONS=true

# Logging
LOG_LEVEL=info

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_me_in_production_at_least_32_bytes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production_at_least_32_bytes
JWT_REFRESH_EXPIRY=7d

# Field Encryption
# AES-256-GCM encryption key. Must be exactly 32 bytes (64 hex characters or 32 characters in base64/ascii)
FIELD_ENCRYPTION_KEY=12345678901234567890123456789012

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@menudot.com

# ImageKit Integration (Phase 4)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
